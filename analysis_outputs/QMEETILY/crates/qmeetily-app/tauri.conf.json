{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "QMeetily",
    "version": "0.1.0",
    "identifier": "dev.qmeetily.app",
    "build": {
        "frontendDist": "../../frontend/out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm --dir ../../frontend dev",
        "beforeBuildCommand": "pnpm --dir ../../frontend build"
    },
    "app": {
        "windows": [
            {
                "title": "QMeetily",
                "width": 1100,
                "height": 720,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'",
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/QMeetily/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
        "resources": []
    },
    "plugins": {}
}
